{
  "name": "bg-skills",
  "version": "1.3.2",
  "private": true,
  "description": "Agent skills for real engineering (BG-skills)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ballganda/BG-skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check": "npm run check-skills && npm run test:check-skills && npm run test:implement && npm run test:replies-line",
    "test:decomp": "python scripts/test-decomp.py",
    "test:implement": "python scripts/test-implement.py",
    "check-skills": "node scripts/check-skills.mjs",
    "test:check-skills": "node scripts/test-check-skills.mjs",
    "test:replies-line": "node scripts/test-replies-line.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
